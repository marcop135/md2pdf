{
  "name": "md2pdf",
  "version": "2.11.3",
  "packageManager": "npm@10.9.3",
  "description": "Mobile-friendly Markdown to PDF in your browser with GFM, syntax highlighting, and Mermaid. Works offline; nothing is uploaded for conversion. Fork of realdennis/md2pdf (MIT).",
  "keywords": [
    "markdown",
    "pdf",
    "pwa",
    "mermaid",
    "gfm",
    "vite",
    "react",
    "offline-first",
    "mobile"
  ],
  "homepage": "./",
  "main": "src/index.js",
  "dependencies": {
    "@babel/runtime": "^7.29.7",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.1",
    "@uiw/codemirror-theme-github": "^4.25.10",
    "@uiw/react-codemirror": "^4.25.10",
    "codemirror": "^6.0.2",
    "github-markdown-css": "^5.9.0",
    "highlight.js": "^11.11.1",
    "mermaid": "^11.15.0",
    "nonaction": "^0.0.5",
    "normalize.css": "^8.0.1",
    "react": "^19.2.7",
    "react-bootstrap-icons": "^1.11.6",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "styled-components": "^6.4.2",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^6.0.3",
    "esbuild": "^0.28.1",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "react-test-renderer": "^19.2.7",
    "source-map-explorer": "^2.5.3",
    "vite": "^8.0.10",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.9"
  },
  "scripts": {
    "preinstall": "npx --yes only-allow npm",
    "prestart": "node scripts/sync-hero.mjs && node scripts/sync-icons.mjs",
    "start": "vite",
    "predev": "node scripts/sync-hero.mjs && node scripts/sync-icons.mjs",
    "dev": "vite",
    "prebuild": "node scripts/sync-hero.mjs && node scripts/sync-icons.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "changelog:lint": "node scripts/changelog-lint.mjs",
    "hero:sync": "node scripts/sync-hero.mjs",
    "icons:sync": "node scripts/sync-icons.mjs"
  },
  "overrides": {
    "@rollup/plugin-terser": "^1.0.0",
    "lodash-es": "^4.18.1",
    "serialize-javascript": "^7.0.5",
    "postcss": "^8.5.10",
    "vite": "^8.0.10",
    "uuid": "^14.0.0"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ]
}
